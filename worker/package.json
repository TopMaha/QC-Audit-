{
  "name": "qc-audit-line-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:schema": "wrangler d1 execute qc-audit-line --remote --file=./schema.sql",
    "db:seed": "wrangler d1 execute qc-audit-line --remote --file=./seed.sql",
    "db:migrate": "wrangler d1 execute qc-audit-line --remote --file=./migrate-001-context-voice.sql",
    "db:schema:local": "wrangler d1 execute qc-audit-line --local --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute qc-audit-line --local --file=./seed.sql",
    "db:migrate:local": "wrangler d1 execute qc-audit-line --local --file=./migrate-001-context-voice.sql",
    "db:migrate:002": "wrangler d1 execute qc-audit-line --remote --file=./migrate-002-flow-heads-push.sql",
    "db:migrate:002:local": "wrangler d1 execute qc-audit-line --local --file=./migrate-002-flow-heads-push.sql",
    "db:migrate:003": "wrangler d1 execute qc-audit-line --remote --file=./migrate-003-pin-sessions.sql",
    "db:migrate:003:local": "wrangler d1 execute qc-audit-line --local --file=./migrate-003-pin-sessions.sql"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "wrangler": "^4.124.0"
  }
}
